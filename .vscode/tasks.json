{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VDI 2230: Tk UI",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "vdi2230"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "problemMatcher": []
    },
    {
      "label": "VDI 2230: All tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
